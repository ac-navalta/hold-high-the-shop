<?xml version="1.0" encoding="utf-8"?>
<!-- Push: covered screen recedes smoothly with restrained parallax and subtle depth dim. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized_decelerate">
    <translate
        android:fromXDelta="0"
        android:toXDelta="-18%"
        android:duration="300" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0.88"
        android:duration="300" />
</set>
