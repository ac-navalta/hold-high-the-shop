<?xml version="1.0" encoding="utf-8"?>
<!-- Underlying screen subtly recedes in depth without harsh horizontal sliding. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized_decelerate">
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.97"
        android:fromYScale="1.0"
        android:toYScale="0.97"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="210" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.90"
        android:duration="210" />
</set>
