<?xml version="1.0" encoding="utf-8"?>
<!-- Covered screen steps back subtly with soft depth dim. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/emphasized_decelerate">
    <translate
        android:fromXDelta="0%"
        android:toXDelta="-6%"
        android:duration="250" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.92"
        android:duration="250" />
</set>
