<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:zAdjustment="top"
    android:shareInterpolator="false">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="210"
        android:interpolator="@interpolator/ease_out" />
    <scale
        android:fromXScale="0.97"
        android:toXScale="1"
        android:fromYScale="0.97"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="260"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
