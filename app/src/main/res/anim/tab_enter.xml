<?xml version="1.0" encoding="utf-8"?>
<!--
    Tabs are peers: the new tab screen simply fades in over the old one.
    The movement (the pill sliding, the page drifting in) is played by the
    arriving screen itself, so the tab bar looks like it never changed.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:zAdjustment="top"
    android:fromAlpha="0"
    android:toAlpha="1"
    android:duration="200"
    android:interpolator="@interpolator/ease_out" />
