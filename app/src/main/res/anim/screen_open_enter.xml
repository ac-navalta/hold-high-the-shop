<?xml version="1.0" encoding="utf-8"?>
<!--
    Push: the new screen slides all the way in from the right, on top, fast
    at first and easing into place, like a card being laid down.
-->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:zAdjustment="top"
    android:fromXDelta="100%"
    android:toXDelta="0"
    android:duration="420"
    android:interpolator="@interpolator/emphasized_decelerate" />
