<?xml version="1.0" encoding="utf-8"?>
<!-- Pop: underlying screen glides smoothly back to rest. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/standard">
    <translate
        android:fromXDelta="-6%"
        android:toXDelta="0%"
        android:duration="210" />
    <alpha
        android:fromAlpha="0.92"
        android:toAlpha="1.0"
        android:duration="210" />
</set>
