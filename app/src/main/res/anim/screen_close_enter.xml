<?xml version="1.0" encoding="utf-8"?>
<!-- Pop: underlying screen glides forward crisply (faster than push for snappy feel). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/standard">
    <translate
        android:fromXDelta="-18%"
        android:toXDelta="0"
        android:duration="250" />
    <alpha
        android:fromAlpha="0.88"
        android:toAlpha="1"
        android:duration="250" />
</set>
