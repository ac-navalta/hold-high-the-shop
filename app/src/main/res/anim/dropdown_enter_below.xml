<?xml version="1.0" encoding="utf-8"?>
<!-- Grows out of the field it opens under. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ease_out">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="160" />
    <scale
        android:fromXScale="0.96" android:toXScale="1"
        android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="0%"
        android:duration="200" />
</set>
