<?xml version="1.0" encoding="utf-8"?>
<!-- Origin-aware enter from bottom edge (anchored above the trigger field). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ease_out">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="130" />
    <scale
        android:fromXScale="0.97"
        android:toXScale="1"
        android:fromYScale="0.90"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="100%"
        android:duration="170" />
</set>
