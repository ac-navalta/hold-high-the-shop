<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.HoldHighTheShop" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/uc_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/uc_green</item>
        <item name="android:windowBackground">@color/uc_cream</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <!-- Keyboard: let the window resize so BarInsets can lift content above it. -->
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
        <!-- Brand colours for system widgets (cursor, selection handles,
             dialogs, time picker, snackbar actions) instead of Material purple. -->
        <item name="colorPrimary">@color/uc_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/uc_mint</item>
        <item name="colorOnPrimaryContainer">@color/uc_green_dark</item>
        <item name="colorSecondary">@color/uc_green</item>
        <item name="colorSecondaryContainer">@color/uc_mint_light</item>
        <item name="colorOnSecondaryContainer">@color/uc_green_dark</item>
        <item name="colorTertiaryContainer">@color/uc_mint_light</item>
        <item name="colorOnTertiaryContainer">@color/uc_green_dark</item>
        <item name="android:colorAccent">@color/uc_green</item>
        <item name="colorControlActivated">@color/uc_green</item>
        <!-- Surfaces and outlines: dialogs, switch tracks, menus. -->
        <item name="colorSurface">@color/uc_cream</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/photo_placeholder</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/uc_cream</item>
        <item name="colorSurfaceContainerHigh">@color/uc_cream</item>
        <item name="colorSurfaceContainerHighest">@color/surface_dim</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorControlHighlight">#1F07683B</item>
        <item name="android:textColorHighlight">@color/uc_mint</item>
        <!-- Motion: sleek Shared-Axis transitions across screens. -->
        <item name="android:windowAnimationStyle">@style/ScreenTransitions</item>
    </style>

    <style name="ScreenTransitions" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/screen_open_exit</item>
    </style>

    <!-- Dropdown lists grow out of and return into the field that opened them. -->
    <style name="DropdownBelow">
        <item name="android:windowEnterAnimation">@anim/dropdown_enter_below</item>
        <item name="android:windowExitAnimation">@anim/dropdown_exit_below</item>
    </style>

    <style name="DropdownAbove">
        <item name="android:windowEnterAnimation">@anim/dropdown_enter_above</item>
        <item name="android:windowExitAnimation">@anim/dropdown_exit_above</item>
    </style>

    <style name="Theme.HoldHighTheShop" parent="Base.Theme.HoldHighTheShop" />

    <!-- Splash -> Sign in shared-element logo handoff only. -->
    <style name="Theme.HoldHighTheShop.Onboarding" parent="Theme.HoldHighTheShop">
        <item name="android:windowActivityTransitions">true</item>
    </style>
</resources>
