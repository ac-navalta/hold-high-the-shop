<?xml version="1.0" encoding="utf-8"?>
<!-- Opened by "Offer a swap" on a swap listing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View style="@style/SheetHandle" />

    <TextView
        style="@style/Kicker"
        android:layout_marginTop="16dp"
        android:textColor="@color/swap_text"
        android:text="@string/swap_kicker" />

    <TextView
        style="@style/SheetTitle"
        android:layout_marginTop="4dp"
        android:text="@string/swap_title" />

    <!-- THEIR ITEM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_photo_tile_round">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                android:tint="#CFC9B4"
                android:contentDescription="@string/cd_item_photo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/swapTheirTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/swapTheirWants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/swap_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SheetLabel"
        android:text="@string/swap_offer_label" />

    <LinearLayout
        android:id="@+id/swapOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- NOTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_banner_mint"
        android:padding="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_verified"
            android:tint="@color/uc_green"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/swapNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/swapSend"
        style="@style/PrimaryButton"
        android:layout_marginTop="20dp"
        android:text="@string/btn_send_swap" />
</LinearLayout>
