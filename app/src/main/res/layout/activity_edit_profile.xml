<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_cream"
    tools:context=".EditProfileActivity">

    <!-- GREEN HEADER -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/uc_green"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="goBack"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/white"
                android:contentDescription="@string/cd_back" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/settings_edit_profile"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/editAvatarContainer"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_avatar_ring"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="pickAvatar"
                android:contentDescription="@string/cd_edit_avatar"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/editInitials"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_avatar_mint"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/me_initials"
                    android:textColor="@color/uc_green"
                    android:textSize="26sp" />

                <ImageView
                    android:id="@+id/editAvatarPhoto"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/cd_edit_avatar" />
            </FrameLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="@string/edit_name" />

            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/me_name"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:maxLines="1"
                android:maxLength="40"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:autofillHints="name" />

            <TextView
                style="@style/SheetLabel"
                android:text="@string/settings_email" />

            <TextView
                android:id="@+id/editEmailValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_note_strip"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/login_email_value"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/ActionHint"
                android:layout_marginTop="6dp"
                android:text="@string/edit_email_hint" />

            <TextView
                style="@style/SheetLabel"
                android:text="@string/edit_program" />

            <LinearLayout
                android:id="@+id/rowEditProgram"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/rowEditProgramText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/prog_default"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="@string/edit_year" />

            <LinearLayout
                android:id="@+id/rowEditYear"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/rowEditYearText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/year_default"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="@string/edit_bio" />

            <EditText
                android:id="@+id/inputBio"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:padding="18dp"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/hint_bio"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="150"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:autofillHints="" />
        </LinearLayout>
    </ScrollView>

    <!-- ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/uc_cream"
        android:elevation="12dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:onClick="goBack"
            android:text="@string/action_cancel" />

        <TextView
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:onClick="saveProfile"
            android:text="@string/btn_save_changes" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
