<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder photo message. Real images come with the backend. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:layout_marginTop="14dp">

    <FrameLayout
        android:id="@+id/bubblePhotoFrame"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_bubble_photo"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/bubblePhotoPlaceholder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_image"
            app:tint="#CFC9B4"
            android:contentDescription="@string/msg_photo" />

        <ImageView
            android:id="@+id/bubblePhotoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/msg_photo" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/msg_sent_now"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
</LinearLayout>
