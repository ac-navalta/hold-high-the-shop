<?xml version="1.0" encoding="utf-8"?>
<!-- Opened by the Safe meetup point card on a listing or exchange details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View style="@style/SheetHandle" />

    <!-- CAMPUS LANDMARK BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_banner_mint"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_green"
            android:elevation="2dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_location"
                app:tint="@color/white"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Kicker"
                android:text="@string/meetup_kicker" />

            <TextView
                android:id="@+id/meetupSheetPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/meetupSheetLandmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Optional seller floor/room meetup note -->
    <LinearLayout
        android:id="@+id/meetupNoteBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            style="@style/Kicker"
            android:text="@string/meetup_note_label" />

        <TextView
            android:id="@+id/meetupSheetNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/SheetLabel"
        android:text="@string/meetup_why" />

    <TextView
        style="@style/ActionHint"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_check_small"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/meetup_why1"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        style="@style/ActionHint"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_check_small"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/meetup_why2"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        style="@style/ActionHint"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_check_small"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/meetup_why3"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meetupCopySpot"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/btn_copy_meetup_spot" />

        <TextView
            android:id="@+id/meetupDone"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/btn_got_it" />
    </LinearLayout>

    <TextView
        android:id="@+id/meetupCallSecurity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/btn_call_security"
        android:textColor="@color/uc_green"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
