<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_cream"
    tools:context=".SettingsActivity">

    <!-- GREEN HEADER -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/uc_green"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="goBack"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/white"
                android:contentDescription="@string/cd_back" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Kicker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_account" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowEditProfile"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_profile" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_edit_profile" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowEmail"
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_verified" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_email" />

                            <TextView
                                style="@style/ActionHint"
                                android:maxLines="1"
                                android:ellipsize="middle"
                                android:text="@string/login_email_value" />
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowProgram"
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_prog_citcs" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_program" />
                        <TextView
                            android:id="@+id/rowProgramValue"
                            style="@style/SettingsValue"
                            android:text="@string/me_meta_short" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Kicker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_notifications" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_chat" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_messages" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_messages_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swMessages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="true" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_clock" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_reservations" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_reservations_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swReservations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="true" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_bell" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_reminders" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_reminders_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swReminders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="true" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_bookmark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_price_drops" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_price_drops_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swPriceDrops"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Kicker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_marketplace" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowDefaultMeetup"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_location" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_default_meetup" />
                        <TextView
                            android:id="@+id/rowDefaultMeetupValue"
                            style="@style/SettingsValue" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_market" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_show_program" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_show_program_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swShowProgram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Kicker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_privacy" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:clickable="false"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_weight="0"
                                android:layout_marginStart="0dp"
                                android:text="@string/settings_active_status" />

                            <TextView
                                style="@style/ActionHint"
                                android:text="@string/settings_active_status_hint" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swActiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checked="true" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowGuidelines"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_flag" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_guidelines" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowSafety"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_verified" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_safety" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Kicker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="@string/settings_support" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowHelp"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_chat" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_help" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/rowAbout"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsIcon"
                            android:src="@drawable/ic_market" />

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_about" />
                        <TextView
                            android:id="@+id/rowAboutValue"
                            style="@style/SettingsValue"
                            android:text="@string/settings_version" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/btnLogout"
                style="@style/OutlineButton"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="24dp"
                android:text="@string/menu_logout" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
