<?xml version="1.0" encoding="utf-8"?>
<!--
    Handing over your item: type in the code the other student shows you.
    The code proves you met; without it the handover can still be confirmed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/screen_margin">

    <View style="@style/SheetHandle" />

    <TextView
        style="@style/Kicker"
        android:layout_marginTop="16dp"
        android:text="@string/code_kicker" />

    <TextView
        android:id="@+id/codeTitle"
        style="@style/SheetTitle"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/codeSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/codeInput"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:fontFamily="@font/poppins_bold"
        android:hint="@string/code_hint"
        android:inputType="number"
        android:maxLength="4"
        android:letterSpacing="0.4"
        android:imeOptions="actionDone"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/divider"
        android:textSize="26sp"
        android:autofillHints="" />

    <!-- Wrong or short code. Not red: nothing is being undone. -->
    <TextView
        android:id="@+id/codeError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/swap_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- The other student never acts in the prototype, so say what their code is. -->
    <TextView
        android:id="@+id/codeDemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_note_strip"
        android:padding="12dp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/codeConfirm"
        style="@style/PrimaryButton"
        android:layout_marginTop="@dimen/screen_margin"
        android:text="@string/btn_confirm_handover" />

    <TextView
        android:id="@+id/codeSkip"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/btn_confirm_without_code"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
