<?xml version="1.0" encoding="utf-8"?>
<!-- Share a listing: preview and link. Sending to other apps comes in a later version. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <View style="@style/SheetHandle" />

    <TextView
        style="@style/SheetTitle"
        android:layout_marginTop="16dp"
        android:text="@string/share_title" />

    <!-- ITEM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_photo_tile_round">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                app:tint="#CFC9B4"
                android:contentDescription="@string/cd_item_photo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shareItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/shareItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/uc_green"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SheetLabel"
        android:text="@string/share_link_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_note_strip"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_share"
            app:tint="@color/text_secondary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/shareLink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/ActionHint"
        android:layout_marginTop="10dp"
        android:text="@string/share_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shareCopy"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/btn_copy_link" />

        <TextView
            android:id="@+id/shareExternal"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/btn_share_via" />
    </LinearLayout>
</LinearLayout>
