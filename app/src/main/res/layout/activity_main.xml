<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-host shell for the four primary tabs (Home, Market, Chats, Profile).
    All four tabs live in one Activity window above a single persistent bottom
    bar so switching tabs is instantaneous (0ms Activity overhead), flash-free,
    and the translucent indicator pill glides continuously from icon to icon.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_cream"
    tools:context=".MainActivity">

    <!-- FOUR TAB PAGES HOSTED IN-PLACE -->
    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <!-- SINGLE PERSISTENT BOTTOM NAVIGATION WITH CONTINUOUS SPRING PILL -->
    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/uc_green"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- One real pill that glides smoothly point-to-point behind the icons -->
        <View
            android:id="@+id/navIndicator"
            android:layout_width="46dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_active" />

        <LinearLayout
            android:id="@+id/navSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/navTab0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="openHome"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="30dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/navIcon0"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        android:tint="@color/white"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabel0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/nav_home"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTab1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="openMarket"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="30dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/navIcon1"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_market"
                        android:tint="@color/text_on_green_dim"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/nav_market"
                    android:textColor="@color/text_on_green_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTab2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="openChats"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="30dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/navIcon2"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat"
                        android:tint="@color/text_on_green_dim"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/nav_chats"
                    android:textColor="@color/text_on_green_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTab3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clipChildren="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="openProfile"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="30dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/navIcon3"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        android:tint="@color/text_on_green_dim"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/nav_profile"
                    android:textColor="@color/text_on_green_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
