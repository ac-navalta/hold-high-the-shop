<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_cream"
    tools:context=".VerifyEmailActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:outlineSpotShadowColor="@color/shadow_green"
                android:outlineAmbientShadowColor="@color/shadow_green"
                app:cardBackgroundColor="@color/white"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_mint">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/uc_green"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/verify_kicker"
                        android:textColor="@color/uc_green"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/verify_title"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/verifyBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:gravity="center" />

                    <!-- 6-Digit Verification Code Boxes -->
                    <LinearLayout
                        android:id="@+id/otpContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <EditText
                            android:id="@+id/otpDigit1"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="yes" />

                        <EditText
                            android:id="@+id/otpDigit2"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/otpDigit3"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/otpDigit4"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/otpDigit5"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="no" />

                        <EditText
                            android:id="@+id/otpDigit6"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:inputType="number"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:selectAllOnFocus="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/verifyError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/danger"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Shown only when EMAIL_WEBHOOK_URL is not configured yet in local.properties -->
                    <TextView
                        android:id="@+id/verifyLocalBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_banner_mint"
                        android:padding="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/uc_green"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/btnCheckVerified"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ProgressBar
                            android:id="@+id/verifyProgress"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/btn_verify_code"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenMailApp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_outline"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/btn_open_email_app"
                        android:textColor="@color/uc_green"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnLocalPreviewContinue"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_outline"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/btn_continue_local_preview"
                        android:textColor="@color/uc_green"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/btnResendVerification"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/btn_resend_verification"
                        android:textColor="@color/uc_green"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btnUseDifferentEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/btn_use_different_email"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
