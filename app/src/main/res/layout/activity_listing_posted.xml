<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uc_cream"
    android:clipChildren="false"
    tools:context=".ListingPostedActivity">

    <View
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/celebrateContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Badge with two rings that ripple out once when the screen opens. -->
        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:clipChildren="false">

            <View
                android:id="@+id/celebrateRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ring_mint"
                android:alpha="0" />

            <View
                android:id="@+id/celebrateRing2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ring_mint"
                android:alpha="0" />

            <FrameLayout
                android:id="@+id/celebrateBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_mint">

                <ImageView
                    android:id="@+id/celebrateCheck"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_verified"
                    app:tint="@color/uc_green"
                    android:contentDescription="@null" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/posted_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/posted_sub"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/postedRefCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="copyReference"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            android:outlineSpotShadowColor="@color/shadow_green"
            android:outlineAmbientShadowColor="@color/shadow_green"
            app:cardBackgroundColor="@color/white"
            app:cardUseCompatPadding="false"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/posted_ref_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/postedRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/posted_ref"
                    android:textColor="@color/uc_green"
                    android:textSize="19sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn_green"
            android:gravity="center"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/btn_view_listing"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="viewListing"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/btn_back_to_market"
            android:textColor="@color/uc_green"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="backToMarket"
            android:foreground="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
