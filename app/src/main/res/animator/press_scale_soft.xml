<?xml version="1.0" encoding="utf-8"?>
<!--
    Press feedback: the control sinks to 0.985 while the finger is down and
    settles back when it lifts. Pressed state already waits for the tap
    timeout inside scrolling lists, so a scroll never flickers it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:valueType="floatType"
                android:duration="110" android:interpolator="@interpolator/ease_out" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.985" android:valueType="floatType"
                android:duration="110" android:interpolator="@interpolator/ease_out" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType"
                android:duration="240" android:interpolator="@interpolator/ease_out" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType"
                android:duration="240" android:interpolator="@interpolator/ease_out" />
        </set>
    </item>
</selector>
