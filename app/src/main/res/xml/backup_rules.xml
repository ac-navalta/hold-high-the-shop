<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude authentication sessions, databases, and private user media from
    Android Auto Backup (API <= 30) to prevent sensitive data leakage.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="media/" />
</full-backup-content>