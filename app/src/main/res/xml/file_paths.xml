<?xml version="1.0" encoding="utf-8"?>
<!-- Strictly scoped FileProvider subpaths (never wildcard root "/"). -->
<paths>
    <!-- Temporary photos captured via MediaStore.ACTION_IMAGE_CAPTURE for listings and chats. -->
    <cache-path
        name="captured_photos"
        path="photos/" />
    <!-- Persisted compressed media shared strictly via temporary read URI grants for full-screen viewing. -->
    <files-path
        name="shared_media"
        path="media/" />
</paths>
