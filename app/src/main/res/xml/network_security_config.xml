<?xml version="1.0" encoding="utf-8"?>
<!-- Enforce HTTPS-only connections across the entire application (zero cleartext HTTP). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
