<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude authentication sessions, local SQLite databases, and cached user media
    from both Cloud Backup and Device-to-Device Transfer (Android 12+ / API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="media/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="media/" />
    </device-transfer>
</data-extraction-rules>