<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.HoldHighTheShop" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/uc_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/uc_green</item>
        <item name="android:windowBackground">@color/uc_cream</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <!-- Keyboard: let the window resize so BarInsets can lift content above it. -->
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
        <!-- Brand colours for system widgets (cursor, selection handles,
             dialogs, time picker, snackbar actions) instead of Material purple. -->
        <item name="colorPrimary">@color/uc_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/uc_mint</item>
        <item name="colorOnPrimaryContainer">@color/uc_green_dark</item>
        <item name="colorSecondary">@color/uc_green</item>
        <item name="colorSecondaryContainer">@color/uc_mint_light</item>
        <item name="colorOnSecondaryContainer">@color/uc_green_dark</item>
        <item name="colorTertiaryContainer">@color/uc_mint_light</item>
        <item name="colorOnTertiaryContainer">@color/uc_green_dark</item>
        <item name="android:colorAccent">@color/uc_green</item>
        <item name="colorControlActivated">@color/uc_green</item>
    </style>

    <style name="Theme.HoldHighTheShop" parent="Base.Theme.HoldHighTheShop" />
</resources>
